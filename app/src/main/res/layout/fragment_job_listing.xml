<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context=".JobListingFragment">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="JobFinder"
            android:textColor="#111111"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSearchIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⌕"
            android:textColor="#111111"
            android:textSize="32sp" />

    </LinearLayout>


    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⌕"
            android:textColor="#111111"
            android:textSize="25sp" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search jobs, skills, location..."
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:textColor="#222222"
            android:textColorHint="#7B8491"
            android:textSize="16sp" />

    </LinearLayout>


    <!-- Job Type Filters -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- All -->
            <TextView
                android:id="@+id/filterAll"
                android:layout_width="62dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_filter_selected"
                android:gravity="center"
                android:text="All"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Full Time -->
            <TextView
                android:id="@+id/filterFullTime"
                android:layout_width="106dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_unselected"
                android:gravity="center"
                android:text="Full Time"
                android:textColor="#222222"
                android:textSize="15sp" />

            <!-- Part Time -->
            <TextView
                android:id="@+id/filterPartTime"
                android:layout_width="106dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_unselected"
                android:gravity="center"
                android:text="Part Time"
                android:textColor="#222222"
                android:textSize="15sp" />

            <!-- Remote -->
            <TextView
                android:id="@+id/filterRemote"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_unselected"
                android:gravity="center"
                android:text="Remote"
                android:textColor="#222222"
                android:textSize="15sp" />

        </LinearLayout>

    </HorizontalScrollView>


    <!-- Jobs -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- Job 1 -->
            <LinearLayout
                android:id="@+id/jobCard1"
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:background="@drawable/bg_job_card"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Frontend Developer"
                        android:textColor="#111111"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ 6L - 10L"
                        android:textColor="#222222"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#222222"
                        android:textSize="24sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Atomxel LLP"
                    android:textColor="#6F7782"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="⌖  Noida, India"
                    android:textColor="#606872"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="▣  Full Time"
                    android:textColor="#606872"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- Job 2 -->
            <LinearLayout
                android:id="@+id/jobCard2"
                android:layout_width="match_parent"
                android:layout_height="158dp"
                android:background="@drawable/bg_job_card"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Android Developer"
                        android:textColor="#111111"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ 5L - 8L"
                        android:textColor="#222222"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#222222"
                        android:textSize="24sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="TechSolutions"
                    android:textColor="#6F7782"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="⌖  Bengaluru, India"
                    android:textColor="#606872"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="▣  Full Time"
                    android:textColor="#606872"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- Job 3 -->
            <LinearLayout
                android:id="@+id/jobCard3"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@drawable/bg_job_card"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Backend Developer"
                        android:textColor="#111111"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ 7L - 12L"
                        android:textColor="#222222"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#222222"
                        android:textSize="24sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="NextGen Systems"
                    android:textColor="#6F7782"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="⌖  Remote"
                    android:textColor="#606872"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="▣  Full Time"
                    android:textColor="#606872"
                    android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>